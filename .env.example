# =============================================================================
# Copy to .env.local and fill in. Nothing here is required to run locally —
# with an empty .env the site falls back to a local SQLite file and local
# disk uploads, so `npm run dev` works out of the box.
# =============================================================================

# --- Required in every environment ---

# Payload encryption secret. Generate one with: openssl rand -hex 24
PAYLOAD_SECRET=replace-with-a-long-random-string

# --- Database ---
# Leave DATABASE_URI unset (or point it at a .db path) to use SQLite locally.
# Set a postgres:// URL and the config switches to the Postgres adapter
# automatically — no code change. Neon works well on Vercel; use the POOLED
# connection string (host contains "-pooler") and include ?sslmode=require.
#
# DATABASE_URI=postgres://user:password@host/dbname?sslmode=require
DATABASE_URI=file:./site.db

# --- Optional ---

# Public base URL. Used for absolute metadata URLs, admin email links, and the
# live-preview iframe origin. Set this to the real domain in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob storage for uploads. Serverless filesystems are ephemeral, so set
# this in any hosted environment. Unset locally = uploads go to disk.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# If BOTH are set, a first admin user is auto-created on a fresh database.
# Leave unset to create the first admin via the /admin screen instead.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=use-a-strong-password
